# Default ToyG4 run configuration.
# Recommended order:
# 1) Set random seeds
# 2) Initialize run manager
# 3) Set output file and detector/generator options
# 4) Start beam

# Optional: Set Geant4 RNG seeds for reproducible runs
/random/setSeeds 12345 67890

/run/initialize

# Optional: Set output ROOT file (supports relative or absolute paths)
/toyG4/run/setOutputFile ./lar_muon_voxels.root

# Optional: Configure voxel size (default is 5 mm)
/toyG4/detector/setVoxelSize 5 mm

# Configure PDG-specific kinetic-energy ranges after initialization.
/toyG4/generator/clearPdgs
/toyG4/generator/addPdgRange 11   0.01 10 GeV log
/toyG4/generator/addPdgRange -11  0.01 10 GeV log
/toyG4/generator/addPdgRange 13   0.01 10 GeV log
/toyG4/generator/addPdgRange -13  0.01 10 GeV log
/toyG4/generator/addPdgRange 2212 0.01 10 GeV log
/toyG4/generator/addPdgRange 22   0.01 10 GeV log
/toyG4/generator/addPdgRange 211  0.01 10 GeV log
/toyG4/generator/addPdgRange -211 0.01 10 GeV log
/toyG4/generator/addPdgRange 2112 0.01 10 GeV log
/toyG4/generator/addPdgRange 11   0.05  2 GeV linear
/toyG4/generator/addPdgRange -11  0.05  2 GeV linear
/toyG4/generator/addPdgRange 13   0.02  2 GeV linear
/toyG4/generator/addPdgRange -13  0.02  2 GeV linear
/toyG4/generator/addPdgRange 2212 0.50  1 GeV linear
/toyG4/generator/addPdgRange 22   0.01  1 GeV linear
/toyG4/generator/addPdgRange 211  0.02  2 GeV linear
/toyG4/generator/addPdgRange -211 0.02  2 GeV linear
/toyG4/generator/addPdgRange 2112 0.50  1 GeV linear
/toyG4/generator/listPdgs

/run/beamOn 100000
