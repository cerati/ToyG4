# Prompt:
# Build a Geant4 project with a simple 20 meter radius world filled with liquid argon.
# The whole world is active volume. Particle gun emits single energy muon of 0.1 - 10 GeV.
# Physics list is QGSP_BERT and everything necessary for EM. Then record the energy deposition
# in 5 mm cubes. Save output to a root file with format (evt no, muon momentum px, py, pz,
# then a long vector of cube x, cube y, cube z, energy deposition in the cube).

/run/initialize

# Optional: Configure voxel size (default is 5 mm)
/toyG4/detector/setVoxelSize 5 mm

# Configure PDG-specific kinetic-energy ranges after initialization.
/toyG4/generator/clearPdgs
/toyG4/generator/addPdgRange 11   0.01 5 GeV
/toyG4/generator/addPdgRange -11  0.01 5 GeV 
/toyG4/generator/addPdgRange 13   0.1 10 GeV
/toyG4/generator/addPdgRange -13  0.1 10 GeV  
/toyG4/generator/addPdgRange 2212 0.2 5 GeV
/toyG4/generator/addPdgRange 22   0.1 10 GeV 
/toyG4/generator/addPdgRange 211  0.2 5 GeV 
/toyG4/generator/addPdgRange -211 0.2 5 GeV
/toyG4/generator/addPdgRange 2112 0.2 2 GeV                          
/toyG4/generator/listPdgs

/run/beamOn 1000
